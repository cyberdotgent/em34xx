# SPDX-License-Identifier: GPL-3.0-or-later
# Writes the version header: the project version (major.minor, plus .patch
# when non-zero) followed by the git short hash, e.g. "0.1-abcdef1".
# Run at every build (target tn34xx_version) so the hash follows HEAD; the
# header is only rewritten when its content changes.
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -DMAJOR=0 -DMINOR=1 -DPATCH=0
#         -DHOMEPAGE=... -P version.cmake
set(_hash "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE _hash
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    set(_hash "")
  endif()
endif()
if(_hash STREQUAL "")
  set(_hash "unknown")
endif()
set(_base "${MAJOR}.${MINOR}")
if(NOT PATCH EQUAL 0)
  set(_base "${_base}.${PATCH}")
endif()
set(_content "/* Generated by cmake/version.cmake; do not edit. */
#ifndef TN34XX_VERSION_H
#define TN34XX_VERSION_H
#define TN34XX_VERSION_MAJOR  ${MAJOR}
#define TN34XX_VERSION_MINOR  ${MINOR}
#define TN34XX_VERSION_PATCH  ${PATCH}
#define TN34XX_VERSION_BASE   \"${_base}\"
#define TN34XX_GIT_HASH       \"${_hash}\"
#define TN34XX_VERSION_STRING \"${_base}-${_hash}\"
#define TN34XX_HOMEPAGE_URL   \"${HOMEPAGE}\"
#endif
")
set(_old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUTPUT}" "${_content}")
endif()
