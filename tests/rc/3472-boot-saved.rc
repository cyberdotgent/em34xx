# Second run: with the setup the first run left in battery-backed RAM, POST
# passes its setup check and the terminal reaches the start-up screen with
# no key pressed (docs/bringup-3472.md).
policy log
speed max
run #600000000
assert byte[7a24]!=ac "no M12 line on row 0"
assert byte[825c]==23&&byte[825e]==24&&byte[8260]==27&&byte[8262]==22 "3472 at row 13, column 30, without Reset"
quit
