# Smoke test for the 3477 ROM set with the modelled hardware (no forced
# results, apart from the temporary display-test shim). It checks
# hardware-visible progress only, and asserts the furthest stage an
# unmodified boot reaches.
assert pc==ffff0 "reset vector"
step
assert cs==f000 "far jump into the F000 segment"
assert byte[2000a]==0c "display-type straps for the default (green) unit"
speed max
run #3000000
# POST has tested RAM and installed handlers for the hardware vectors.
assert word[18]!=0||word[1a]!=0 "vector 06h (timer) installed"
assert word[38]!=0||word[3a]!=0 "vector 0Eh (keyboard) installed"
# The communications loop-back test passes with the Twinax engine. The
# display test (VDO) measures a 4-bit video signature in 2012F bits 7-4;
# its function is unknown and a TEMPORARY shim in the display controller
# stands in for it (docs/bringup-3477.md). POST must pass it and, with no
# saved setup (cleared battery RAM), end in Offline Setup.
run #22000000
assert byte[20010]!=9b "no alarm: POST passed the display test"
assert word[20130]==4200 "main window at C200"
assert byte[c257]==d6&&byte[c25a]==86&&byte[c25d]==86 "row 0 shows 'Off(line Setup)' in EBCDIC"
unmapped
info
quit
