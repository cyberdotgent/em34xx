# ROM images are proprietary research inputs and must never be committed.
# Everything in roms/ is ignored except the manifest (roms/ROMS.md).
/roms/*
!/roms/ROMS.md

# EEPROM/NVRAM images written by the emulated firmware (setup data).
*.eeprom
*.nvram

# Build output and fetched test data
/build/
/vcpkg_installed/
/testdata/

# Private reverse-engineering notes derived from proprietary ROMs and
# software (disassembly, dumps, extracted fonts). Never commit.
/analysis_notes/
